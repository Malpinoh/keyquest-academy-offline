<Application x:Class="KeyQuest.Academy.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Forest" Color="#244B3B"/><SolidColorBrush x:Key="Cream" Color="#F6F1E6"/><SolidColorBrush x:Key="Ink" Color="#26342D"/>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Foreground" Value="#244B3B"/><Setter Property="Background" Value="#E8E1D2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
