{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyQuest Academy Legacy",
  "version": "1.0.0",
  "identifier": "com.malpinoh.keyquestacademy.legacy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyQuest Academy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Education",
    "shortDescription": "Offline typing lessons, tests and games",
    "longDescription": "Learn touch typing with guided lessons, typing tests, educational guides and games. Practice progress stays on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
